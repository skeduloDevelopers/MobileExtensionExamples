{
  "firstPage": "JobAttendeesListPage",
  "pages": {
    "JobAttendeesListPage": {
      "title": "form.JobAttendeesListPages.JobAttendeesTitle",
      "type": "list",
      "addNew": {
        "text": "form.JobAttendeesListPages.Add",
        "destinationPage": "UpsertJobAttendeePage",
        "defaultData": {
          "data": {
            "JobId": "${metadata.contextObjectId}"
          },
          "objectName": "Attendees"
        }
      },
      "sourceExpression": "formData.Attendees",
      "emptyText": "form.JobAttendeesListPages.Empty",
      "search": {
        "placeholder": "form.JobAttendeesListPages.SearchPlaceholder",
        "filterOnProperties": ["Contact.FirstName", "Contact.LastName"]
      },
      "itemLayout": {
        "type": "titleAndCaption",
        "title": "form.JobAttendeesListPages.ItemTitle",
        "caption": "form.JobAttendeesListPages.ItemCaption"
      },
      "itemClickDestination": "UpsertJobAttendeePage"
    },
    "UpsertJobAttendeePage": {
      "type": "flat",
      "upsert": {
        "insertTitle": "form.UpsertJobAttendeePage.AddAttendee",
        "updateTitle": "form.UpsertJobAttendeePage.EditAttendee",
        "insertButtonText": "form.UpsertJobAttendeePage.Add",
        "updateButtonText": "form.UpsertJobAttendeePage.Update",
        "defaultDataForNewObject": {
          "CreatedDate": "${now()}"
        },
        "validator": [],
        "saveDraft": {
          "askWhenBack": true
        }
      },
      "delete": {
        "canDeleteExpression": "converters.data.isTempUID(pageData) == false",
        "text": "form.UpsertJobAttendeePage.DeleteAttendee",
        "confirm": {
          "title": "form.UpsertJobAttendeePage.ConfirmDeleteTitle",
          "description": "form.UpsertJobAttendeePage.ConfirmDeleteDescription",
          "yesBtn": "form.UpsertJobAttendeePage.ConfirmDeleteYesButton",
          "noBtn": "form.UpsertJobAttendeePage.ConfirmDeleteNoButton"
        }
      },
      "saveDraft": {
        "askWhenBack": true
      },
      "items": [
        {
            "type": "textView",
            "title": "form.UpsertJobAttendeePage.AttendeeNameLabel",
            "text": "form.UpsertJobAttendeePage.AttendeeName"
        },
        {
          "type": "selectEditor",
          "title": "form.UpsertJobAttendeePage.AttendeeStatus",
          "placeholder": "form.UpsertJobAttendeePage.AttendeeStatusPlaceholder",
          "mandatory": true,
          "valueExpression": "pageData.Status",
          "sourceExpression": "sharedData.__vocabulary.AttendeeStatus",
          "displayExpression": "pageData.Status",
          "selectPage": {
          "itemTitle": "form.UpsertJobAttendeePage.SelectAttendeeStatusItemTitle",
          "title": "form.UpsertJobAttendeePage.SelectAttendeeStatusPageTitle",
          "searchBar": {}
          },
        "validator": [
        {
        "type": "expression",
        "expression": "pageData.Status",
        "errorMessage": "FieldIsRequired"
        }
        ]
        }
      ]
    }
  }
}