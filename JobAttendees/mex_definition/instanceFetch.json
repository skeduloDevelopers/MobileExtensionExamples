{
  "type": "GraphQl",
  "Attendees": {
    "object": "Attendees",
    "fields": [
      "UID",
      "JobId",
      "Status",
      "CancelReason",
      "TimeCancelled",
      "Waitlisted",
      "Notes",
      "CreatedDate",
      "Contact.UID",
      "Contact.FirstName",
      "Contact.LastName"
    ],
    "filter": "JobId == '${jobUID}'",
    "variables": {
      "jobUID": "$it.UID"
    }
  }
}